<!DOCTYPE html>
<html dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>بررسی بورسیه - Edusphere</title>
<style>
body{font-family:tahoma;background:#0d1117;color:#fff;text-align:center;padding:20px}
.card{background:#161b22;max-width:400px;margin:30px auto;padding:25px;border-radius:15px;border:1px solid #30363d}
input{width:90%;padding:14px;border-radius:8px;border:1px solid #444;background:#0d1117;color:#fff;margin:15px 0}
button{background:#238636;color:#fff;border:none;padding:13px;width:95%;border-radius:8px;font-size:16px}
.result{margin-top:20px;padding:15px;border-radius:10px;display:none}
.ok{background:#1f3924;color:#7ee787} .bad{background:#3c1f1f;color:#ff7b72}
</style>
</head>
<body>
<div class="card">
<h2>🎓 بررسی وضعیت بورسیه</h2>
<input id="code" placeholder="کد را بزن مثلا 12345">
<button onclick="check()">بررسی وضعیت</button>
<div id="r" class="result"></div>
</div>
<script>
const list=[
{id:"12345",name:"احمد",status:"مقبول ✅"},
{id:"2024",name:"دانشجوی تست",status:"قید انتظار ⏳"},
];
function check(){
let c=document.getElementById('code').value.trim();
let r=document.getElementById('r');
r.style.display='block';
let f=list.find(x=>x.id==c);
if(f){r.className='result ok'; r.innerHTML=`${f.name}<br><b>${f.status}</b>`;}
else{r.className='result bad'; r.innerHTML='یافت نشد ❌';}
}
</script>
</body>
</html>
